---
import Logo from "./Logo.astro";
import { site } from "../data/site";
---

<section id="top" class="hero">
  <svg class="bg-triangle" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path
      d="M32 7c2.2 0 4.2 1.2 5.3 3.1l19.4 35.2c2.2 4-0.7 8.9-5.3 8.9H14.6c-4.6 0-7.5-4.9-5.3-8.9L28.7 10.1C29.8 8.2 31.8 7 32 7Z"
    ></path>
  </svg>

  <div class="container hero-inner">
    <div class="hero-logo logo-hover"><Logo size={132} /></div>
    <p class="hero-eyebrow" aria-hidden="true">// {site.nameEn.toUpperCase()} //</p>
    <h1 class="hero-title">{site.name}</h1>
    <p class="hero-name">{site.author} ｜ {site.authorAka}</p>
    <div class="roles">
      {site.roles.map((r) => <span class="role-chip">{r}</span>)}
    </div>
    <p class="hero-tagline">{site.tagline}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="/blog">看部落格 →</a>
      <a class="btn btn-secondary" href="#connect">聯絡阿波</a>
    </div>
  </div>

  <div class="checker-strip" aria-hidden="true"></div>

  <a class="scroll-cue" href="#about" aria-label="往下捲動">
    <span aria-hidden="true">▾</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(86vh, 760px);
    display: flex;
    align-items: center;
    text-align: center;
    background:
      radial-gradient(120% 90% at 50% -10%, rgba(225, 6, 0, 0.06), transparent 60%),
      var(--bg);
  }
  /* speed lines — angled streaks sweeping across the tarmac */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      115deg,
      transparent 0 140px,
      rgba(21, 24, 31, 0.035) 140px 142px,
      transparent 142px 260px,
      rgba(225, 6, 0, 0.05) 260px 263px,
      transparent 263px 420px
    );
  }
  :root[data-theme="dark"] .hero {
    background:
      radial-gradient(90% 60% at 78% 0%, rgba(255, 59, 48, 0.14), transparent 55%),
      radial-gradient(70% 50% at 12% 12%, rgba(255, 176, 32, 0.07), transparent 60%),
      linear-gradient(180deg, #05070b, var(--bg) 62%);
  }
  :root[data-theme="dark"] .hero::before {
    background: repeating-linear-gradient(
      115deg,
      transparent 0 140px,
      rgba(238, 240, 244, 0.045) 140px 142px,
      transparent 142px 260px,
      rgba(255, 59, 48, 0.1) 260px 263px,
      transparent 263px 420px
    );
  }
  .bg-triangle {
    position: absolute;
    width: min(85vw, 720px);
    height: auto;
    right: -12%;
    top: 8%;
    opacity: 0.05;
    color: var(--racing-500);
    fill: currentColor;
    pointer-events: none;
    transform: rotate(8deg);
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-9);
  }
  .hero-logo {
    animation: pop var(--dur-hero) var(--ease-spring) both;
  }
  .hero-eyebrow {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.32em;
    color: var(--racing-500);
    margin-top: var(--space-3);
  }
  :root[data-theme="dark"] .hero-eyebrow {
    color: var(--racing-300);
  }
  .hero-title {
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 3.5rem);
    margin-top: var(--space-1);
  }
  .hero-name {
    color: var(--text-muted);
    font-size: 1.05rem;
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-block: var(--space-2);
  }
  .role-chip {
    font-family: var(--font-display);
    font-style: italic;
    padding: 4px 16px;
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
    background: var(--racing-100);
    color: var(--racing-800);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  :root[data-theme="dark"] .role-chip {
    background: rgba(255, 59, 48, 0.14);
    color: var(--racing-300);
  }
  .hero-tagline {
    max-width: 46ch;
    color: var(--text-muted);
    line-height: 1.9;
    margin-top: var(--space-2);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-5);
  }
  /* finish-line checker strip along the hero's bottom edge */
  .checker-strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    background: repeating-conic-gradient(var(--steel-900) 0% 25%, transparent 0% 50%) 0 0 / 24px 24px;
    opacity: 0.16;
    pointer-events: none;
  }
  :root[data-theme="dark"] .checker-strip {
    background: repeating-conic-gradient(#eef0f4 0% 25%, transparent 0% 50%) 0 0 / 24px 24px;
    opacity: 0.1;
  }
  .scroll-cue {
    position: absolute;
    bottom: var(--space-5);
    left: 50%;
    transform: translateX(-50%);
    color: var(--racing-500);
    font-size: 1.5rem;
    text-decoration: none;
    animation: bounce 1.8s var(--ease-in-out) infinite;
  }
  :root[data-theme="dark"] .scroll-cue {
    color: var(--racing-300);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes bounce {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-logo,
    .scroll-cue {
      animation: none;
    }
  }
</style>
